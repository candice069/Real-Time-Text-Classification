# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=text-classification-requests
KAFKA_CONSUMER_GROUP=classifier-group
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# Model Configuration
MODEL_PATH=/app/models/bert-classifier
MODEL_NAME=bert-base-uncased
MAX_SEQUENCE_LENGTH=512
BATCH_SIZE=32
CONFIDENCE_THRESHOLD=0.8

# Performance Tuning
INFERENCE_WORKERS=4
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
METRICS_RETENTION_DAYS=15

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Set a unique local password before starting Grafana
GRAFANA_ADMIN_PASSWORD=
